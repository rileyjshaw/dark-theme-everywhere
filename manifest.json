{
	"manifest_version": 3,
	"name": "Dark Theme Everywhere",
	"short_name": "Dark Theme",
	"description": "Darkens bright pages for easier night time reading.  Unofficial improvement of 'Nicer Inverter'.",
	"version": "6.0.2",
	"minimum_chrome_version": "121",
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"action": {
		"default_icon": "icon38.png",
		"default_title": "Toggle dark theme"
	},
	"icons": {
		"128": "icon128.png",
		"48": "icon48.png",
		"16": "icon16.png"
	},
	"permissions": ["storage", "offscreen"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["client.js"],
			"css": ["main.css"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "dark-theme-everywhere@rileyjshaw.com",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
